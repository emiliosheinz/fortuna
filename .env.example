POSTGRES_DB=fortuna
POSTGRES_USER=fortuna
POSTGRES_PASSWORD=fortuna

REDIS_PASSWORD=fortuna

# Grafana admin login (consumed by both docker-compose.yaml and
# docker-compose.prod.yaml). Dev defaults both fields to "admin" if unset;
# prod defaults the user but REQUIRES an explicit password — leaving
# GF_SECURITY_ADMIN_PASSWORD unset in prod will stop Grafana from booting.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
