# Single source of truth for every overridable knob.
# `cp .env.example .env`, fill in the empty secrets, and every service in
# docker-compose*.yaml picks the values up via ${VAR:?required}.

# Postgres
POSTGRES_DB=fortuna
POSTGRES_USER=fortuna
POSTGRES_PASSWORD=fortuna
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=fortuna

# Google OIDC (create credentials at https://console.cloud.google.com/)
OIDC_ISSUER_URL=https://accounts.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# API
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://api:3000

# Web
WEB_PORT=3001
WEB_HOST=0.0.0.0

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
