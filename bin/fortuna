#!/usr/bin/env bash
set -euo pipefail

# Pass -it only when stdin is a terminal. Engineers running from iTerm
# get the interactive shell; non-interactive callers (CI, Claude Code,
# scripts piping through this) still execute inside the workspace
# container but without requesting a TTY, which would otherwise fail
# with "the input device is not a TTY".
if [ -t 0 ]; then
  docker_tty_flag="-it"
else
  docker_tty_flag=""
fi

case "${1:-}" in
  db)
    shift
    docker compose run --rm migration pnpm --filter api run "$@"
    ;;
  e2e)
    shift
    if [ $# -eq 0 ]; then
      trap 'docker compose -f docker-compose.e2e.yaml down' EXIT
      docker compose -f docker-compose.e2e.yaml run --rm web-e2e
    else
      docker compose -f docker-compose.e2e.yaml "$@"
    fi
    ;;
  "")
    docker exec ${docker_tty_flag} workspace sh
    ;;
  *)
    docker exec ${docker_tty_flag} workspace "$@"
    ;;
esac
