#!/usr/bin/env bash
set -euo pipefail

# Pass -it only when stdin is a terminal. Engineers running from iTerm
# get the interactive shell; non-interactive callers (CI, Claude Code,
# scripts piping through this) still execute inside the workspace
# container but without requesting a TTY, which would otherwise fail
# with "the input device is not a TTY".
if [ -t 0 ]; then
  docker_tty_flag="-it"
else
  docker_tty_flag=""
fi

case "${1:-}" in
  db)
    shift
    task="${1:-}"
    if [ -z "$task" ]; then
      echo "Usage: bin/fortuna db <task> [args...]" >&2
      exit 1
    fi
    shift
    docker compose run --rm migration pnpm turbo "$task" --filter=api -- "$@"
    ;;
  e2e)
    shift
    if [ $# -eq 0 ]; then
      trap 'docker compose -f docker-compose.e2e.yaml down' EXIT
      docker compose -f docker-compose.e2e.yaml run --rm web-e2e
    else
      docker compose -f docker-compose.e2e.yaml "$@"
    fi
    ;;
  fx)
    shift
    task="${1:-}"
    if [ "$task" != "fetch" ]; then
      echo "Usage: bin/fortuna fx fetch [--from YYYY-MM-DD] [--to YYYY-MM-DD]" >&2
      echo "  no args                pull today's EUR-anchored rates (the prod cron)" >&2
      echo "  --from <ISO>           backfill from that date until today" >&2
      echo "  --from <ISO> --to <ISO> backfill the explicit range" >&2
      exit 1
    fi
    shift
    from=""
    to=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --from) from="${2:-}"; shift 2 ;;
        --to)   to="${2:-}";   shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
      esac
    done
    if [ -n "$from" ] && [ -n "$to" ]; then
      body="{\"from\":\"$from\",\"to\":\"$to\"}"
    elif [ -n "$from" ]; then
      body="{\"from\":\"$from\"}"
    elif [ -n "$to" ]; then
      echo "Error: --to requires --from" >&2
      exit 1
    else
      body="{}"
    fi
    docker exec api curl -fsS -X POST \
      -H 'Content-Type: application/json' \
      -d "$body" \
      http://localhost:3000/internal/fx/fetch
    echo
    ;;
  "")
    docker exec ${docker_tty_flag} workspace sh
    ;;
  *)
    docker exec ${docker_tty_flag} workspace "$@"
    ;;
esac
